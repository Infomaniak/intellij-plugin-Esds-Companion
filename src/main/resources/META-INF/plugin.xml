<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.infomaniak.DsTokenInfoPlugin</id>
    <name>Infomaniak Design System Token Info</name>
    <vendor url="https://github.com/Infomaniak/android-design-system">Infomaniak</vendor>

    <description><![CDATA[
        Shows the real value of <b>Infomaniak design system</b> tokens directly in code completion.
        <br/><br/>
        Instead of the uninformative <code>Dp</code> type, completing
        <code>EsdsTheme.icon.sizeSm</code> displays <code>20dp</code> on the right of the
        completion item. Works for <code>EsdsTheme.icon</code>, <code>EsdsTheme.spacing</code>
        and <code>EsdsTheme.radius</code>.
        <br/><br/>
        Tokens can also be found <b>by value</b>: typing <code>EsdsTheme.spacing.16</code> offers
        <code>xl</code>, and picking it replaces the number with the token name.
        <br/><br/>
        Optionally, <b>inlay hints</b> can show the same values inline next to each call site.
        Turn them on under <i>Settings | Editor | Inlay Hints | Values</i>.
        <br/><br/>
        Values are generated from the design system's default theme; all app themes map these
        dimension tokens to the same primitives, so the displayed values are accurate everywhere.
    ]]></description>

    <!-- Core platform only: the plugin works in Android Studio and every IntelliJ-based IDE. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!--
          Must be registered for `kotlin` specifically, NOT for `any`: the platform resolves
          completion contributors with `allForLanguageOrAny`, which appends the `any`
          contributors *after* all language-specific ones. An `any` contributor therefore runs
          last, and `runRemainingContributors` would have nothing left to decorate.

          `language="kotlin"` is a plain string key, so no dependency on the Kotlin plugin is
          needed; the extension simply never matches if that plugin is absent.
        -->
        <completion.contributor
                language="kotlin"
                order="first"
                implementationClass="com.infomaniak.dstokeninfo.EsdsTokenCompletionContributor"/>

        <!--
          Declarative inlay hints get a per-user on/off switch for free, under
          Settings | Editor | Inlay Hints. Disabled by default so the plugin stays unobtrusive
          until someone opts in.
        -->
        <codeInsight.declarativeInlayProvider
                language="kotlin"
                providerId="com.infomaniak.dstokeninfo.tokenValues"
                group="VALUES_GROUP"
                isEnabledByDefault="false"
                bundle="messages.DsTokenInfoBundle"
                nameKey="inlay.esdsTokenValues.name"
                descriptionKey="inlay.esdsTokenValues.description"
                implementationClass="com.infomaniak.dstokeninfo.EsdsTokenInlayHintsProvider"/>

        <!-- Makes the inlay hints clickable: jumps to the design system source. -->
        <codeInsight.inlayActionHandler
                handlerId="com.infomaniak.dstokeninfo.navigateToToken"
                implementationClass="com.infomaniak.dstokeninfo.EsdsTokenNavigationHandler"/>
    </extensions>
</idea-plugin>
