<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.infomaniak.esdscompanion</id>
    <name>Esds Companion</name>
    <vendor url="https://www.infomaniak.com">Infomaniak</vendor>

    <description><![CDATA[
        Companion for the <a href="https://github.com/Infomaniak/android-design-system">Infomaniak
        Android design system</a> (ESDS): see the real value behind dimension tokens while you write
        Kotlin.
        <ul>
            <li><b>Completion shows values</b>: <code>EsdsTheme.icon.sizeSm</code> displays
                <code>20dp</code> instead of the uninformative <code>Dp</code> type.</li>
            <li><b>Find a token by value</b>: type <code>EsdsTheme.spacing.16</code> and pick
                <code>xl</code>; the number is replaced with the token name.</li>
            <li><b>Inlay hints</b> show the value next to each call site. Turn them off under
                <i>Settings | Editor | Inlay Hints | Values</i>.</li>
            <li><b>Ctrl/Cmd-click a hint</b> to open the design system file defining the token.</li>
        </ul>
        Covers <code>icon</code>, <code>spacing</code> and <code>radius</code> tokens, on
        <code>EsdsTheme</code> as well as per-app themes such as <code>MailTheme</code>.
        Values come from the design system's default theme.
    ]]></description>

    <!-- Core platform only: the plugin works in Android Studio and every IntelliJ-based IDE. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!--
          Must be registered for `kotlin` specifically, NOT for `any`: the platform resolves
          completion contributors with `allForLanguageOrAny`, which appends the `any`
          contributors *after* all language-specific ones. An `any` contributor therefore runs
          last, and `runRemainingContributors` would have nothing left to decorate.

          `language="kotlin"` is a plain string key, so no dependency on the Kotlin plugin is
          needed; the extension simply never matches if that plugin is absent.
        -->
        <completion.contributor
                language="kotlin"
                order="first"
                implementationClass="com.infomaniak.esdscompanion.EsdsTokenCompletionContributor"/>

        <!--
          Declarative inlay hints get a per-user on/off switch for free, under
          Settings | Editor | Inlay Hints. Enabled by default; each user can turn them off there.
        -->
        <codeInsight.declarativeInlayProvider
                language="kotlin"
                providerId="com.infomaniak.esdscompanion.tokenValues"
                group="VALUES_GROUP"
                isEnabledByDefault="true"
                bundle="messages.EsdsCompanionBundle"
                nameKey="inlay.esdsTokenValues.name"
                descriptionKey="inlay.esdsTokenValues.description"
                implementationClass="com.infomaniak.esdscompanion.EsdsTokenInlayHintsProvider"/>

        <!-- Makes the inlay hints clickable: jumps to the design system source. -->
        <codeInsight.inlayActionHandler
                handlerId="com.infomaniak.esdscompanion.navigateToToken"
                implementationClass="com.infomaniak.esdscompanion.EsdsTokenNavigationHandler"/>
    </extensions>
</idea-plugin>
